"X_U26         VIMON MID MID VCC IQ_SRC_OPAx192  PARAMS: GAIN=1E-3\n"
"X_U27         MID VIMON VEE MID IQ_SRC_OPAx192  PARAMS: GAIN=1E-3\n"
"X_U30         N32347 N31303 MID N32510 AOL_1_OPAx192  PARAMS: GAIN=1E-4 IPOS="
".5 INEG=-.5\n"
"X_U31         N32510 MID MID CLAMP AOL_2_OPAx192  PARAMS: GAIN=74.5E-3 IPOS=2"
".4   INEG=-2.4\n"
"X_U32         N39892 MID MID N46041 ZO_SRC_OPAx192  PARAMS: GAIN=66667 IPOS=5"
"E4   INEG=-5E4\n"
"X_U35         N56849 N57325 CLAW_CLAMP MID CLAW_SRC_OPAx192  PARAMS: GAIN=1 I"
"POS=0.55E1   INEG=-0.55E1\n"
"X_U36         N24207 MID FEMT_OPAx192  PARAMS: NVRF=1.5\n"
"X_U37         ESDN MID FEMT_OPAx192  PARAMS: NVRF=1.5\n"
"X_U4          N25397 N24207 VOS_DRIFT_OPAx192  PARAMS: DC=-2.88E-6 POL=1 DRIF"
"T=0.2E-6\n"
"X_U5          ESDN ESDP VCC VEE ESD_IN_OPAx192\n"
"X_U6          N28678 MID N32236 MID N31389 N31737 VCM_CLAMP_OPAx192  PARAMS: "
"GAIN=1\n"
".MODEL R_NOISELESS RES (T_ABS=-273.15)\n"
".ENDS OPAx192\n"
"\n"
"*--------------- End of main subcircuit ----------------------\n"
"*--------------- References are appended below ---------------\n"
"\n"
".SUBCKT AOL_1_OPAx192 VC+ VC- IOUT+ IOUT- PARAMS: GAIN=1E-4 IPOS=.5 INEG=-.5"
"\n"
"G1 IOUT+ IOUT- VALUE={LIMIT(GAIN*V(VC+,VC-),INEG,IPOS)}\n"
".ENDS  AOL_1_OPAx192\n"
"\n"
".SUBCKT AOL_2_OPAx192 VC+ VC- IOUT+ IOUT- PARAMS: GAIN=74.5E-3 IPOS=2.4 INEG="
"-2.4\n"
"G1 IOUT+ IOUT- VALUE={LIMIT(GAIN*V(VC+,VC-),INEG,IPOS)}\n"
".ENDS  AOL_2_OPAx192\n"
"\n"
".SUBCKT BLOCK_DC_H1_OPAx192  1 2 3 4  \n"
"H_H1         3 4 VH_H1 1K\n"
"VH_H1         1 2 0V\n"
".ENDS  BLOCK_DC_H1_OPAx192\n"
"\n"
".SUBCKT BLOCK_DC_H2_OPAx192  1 2 3 4  \n"
"H_H2         3 4 VH_H2 1\n"
"VH_H2         1 2 0V\n"
".ENDS  BLOCK_DC_H2_OPAx192\n"
"\n"
".SUBCKT BLOCK_DC_H3_OPAx192  1 2 3 4  \n"
"H_H3         3 4 VH_H3 -1\n"
"VH_H3         1 2 0V\n"
".ENDS  BLOCK_DC_H3_OPAx192\n"
"\n"
".SUBCKT BLOCK_DC_S1_OPAx192  1 2 3 4  \n"
"S_S1         3 4 1 2 _S1\n"
"RS_S1         1 2 1G\n"
".MODEL         _S1 VSWITCH ROFF=1E9 RON=10M VOFF=0.0V VON=10MV\n"
".ENDS  BLOCK_DC_S1_OPAx192\n"
"\n"
".SUBCKT BLOCK_DC_S2_OPAx192  1 2 3 4  \n"
"S_S2         3 4 1 2 _S2\n"
"RS_S2         1 2 1G\n"
".MODEL         _S2 VSWITCH ROFF=1E9 RON=10M VOFF=0.0V VON=10MV\n"
".ENDS  BLOCK_DC_S2_OPAx192\n"
"\n"
".SUBCKT CL_SRC_OPAx192 VC+ VC- IOUT+ IOUT- PARAMS: GAIN=1 IPOS=1.1E1 INEG=-1."
"1E1\n"
"G1 IOUT+ IOUT- VALUE={LIMIT(GAIN*V(VC+,VC-),INEG,IPOS)}\n"
".ENDS  CL_SRC_OPAx192\n"
"\n"
".SUBCKT CLAMP_AMP_HI_OPAx192 VC+ VC- VIN COM VO+ VO- PARAMS: G=10\n"
"GVO+ COM VO+ VALUE = {IF(V(VIN,COM)>V(VC+,COM),((V(VIN,COM)-V(VC+,COM))*G),0)"
"}\n"
"GVO- COM VO- VALUE = {IF(V(VIN,COM)<V(VC-,COM),((V(VC-,COM)-V(VIN,COM))*G),0)"
"}\n"
".ENDS  CLAMP_AMP_HI_OPAx192\n"
"\n"
".SUBCKT CLAMP_AMP_LO_OPAx192 VC+ VC- VIN COM VO+ VO- PARAMS: G=1\n"
"GVO+ COM VO+ VALUE = {IF(V(VIN,COM)>V(VC+,COM),((V(VIN,COM)-V(VC+,COM))*G),0)"
"}\n"
"GVO- COM VO- VALUE = {IF(V(VIN,COM)<V(VC-,COM),((V(VC-,COM)-V(VIN,COM))*G),0)"
"}\n"
".ENDS  CLAMP_AMP_LO_OPAx192\n"
"\n"
".SUBCKT CLAW_SRC_OPAx192 VC+ VC- IOUT+ IOUT- PARAMS: GAIN=1 IPOS=0.55E1 INEG="
"-0.55E1\n"
"G1 IOUT+ IOUT- VALUE={LIMIT(GAIN*V(VC+,VC-),INEG,IPOS)}\n"
".ENDS  CLAW_SRC_OPAx192\n"
"\n"
".SUBCKT CLAWN_OPAx192 VC+ VC- IOUT+ IOUT-\n"
"G1 IOUT+ IOUT- TABLE {(V(VC+,VC-))} = (0, 8.23E-6) (15.9, 6.9E-4) (32.6, 1.5E"
"-3) (46.2, 2.2E-3) (55.4, 2.9E-3) (62.8, 3.75E-3) (67.7, 4.14E-3) (68.9, 2.2E"
"-2)\n"
".ENDS  CLAWN_OPAx192\n"
"\n"
".SUBCKT CLAWP_OPAx192 VC+ VC- IOUT+ IOUT-\n"
"G1 IOUT+ IOUT- TABLE {(V(VC+,VC-))} = (0, 8.3E-6) (31.9, 1.41E-3) (44.7, 2.13"
"E-3) (57.1, 3.04E-3) (63.8, 3.76E-3) (66.5, 4.23E-3) (67.7, 4.54E-3) (68.9, 1"
".77E-2)\n"
".ENDS  CLAWP_OPAx192\n"
"\n"
".SUBCKT ESD_IN_OPAx192 ESDN ESDP VCC VEE\n"
".MODEL ESD_SW VSWITCH(RON=50 ROFF=1E12 VON=700E-3 VOFF=100E-3)\n"
"S1 ESDN VCC ESDN VCC ESD_SW\n"
"S2 ESDP VCC ESDP VCC ESD_SW\n"
"S3 VEE ESDN VEE ESDN ESD_SW\n"
"S4 VEE ESDP VEE ESDP ESD_SW\n"
".ENDS  ESD_IN_OPAx192\n"
"\n"
".SUBCKT ESD_OUT_OPAx192 OUT VCC VEE\n"
".MODEL ESD_SW VSWITCH(RON=50 ROFF=1E12 VON=700E-3 VOFF=100E-3)\n"
"S1 OUT VCC OUT VCC ESD_SW\n"
"S2 VEE OUT VEE OUT ESD_SW\n"
".ENDS  ESD_OUT_OPAx192\n"
"\n"
".SUBCKT FEMT_OPAx192 1 2 PARAMS: NVRF=1.5\n"
"E1 3 0 5 0 10\n"
"R1 5 0 {1.184*PWR(NVRF,2)}\n"
"R2 5 0 {1.184*PWR(NVRF,2)}\n"
"G1 1 2 3 0 1E-6\n"
".ENDS  FEMT_OPAx192\n"
"\n"
".SUBCKT GR_SRC_OPAx192 VC+ VC- IOUT+ IOUT- PARAMS: GAIN=1 IPOS=4.8E1 INEG=-4."
"8E1\n"
"G1 IOUT+ IOUT- VALUE={LIMIT(GAIN*V(VC+,VC-),INEG,IPOS)}\n"
".ENDS  GR_SRC_OPAx192\n"
"\n"
".SUBCKT IQ_SRC_OPAx192 VC+ VC- IOUT+ IOUT- PARAMS: GAIN=1E-3\n"
"G1 IOUT- IOUT+ VALUE={IF( (V(VC+,VC-)<=0),0,GAIN*V(VC+,VC-) )}\n"
".ENDS  IQ_SRC_OPAx192\n"
"\n"
".SUBCKT OL_SENSE_OPAx192 1  2  3  4\n"
"GSW+ 1 2 VALUE = {IF((V(3,1)>10E-3 | V(4,1)>10E-3),1,0)}\n"
".ENDS  OL_SENSE_OPAx192\n"
"\n"
".SUBCKT SW_OL_OPAx192 SW_OL_OPAx192 MID CAP_L CAP_R\n"
".MODEL OL_SW VSWITCH(RON=1E-3 ROFF=1E9 VON=900E-3 VOFF=800E-3)\n"
"S1 CAP_L CAP_R SW_OL_OPAx192 MID OL_SW\n"
".ENDS  SW_OL_OPAx192\n"
"\n"
