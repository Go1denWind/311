".MODEL DVN D (KF={PWR(FLW,0.5)/1E11} IS=1.0E-16)\n"
"D1 7 0 DVN \n"
"D2 8 0 DVN \n"
"E1 3 6 7 8 {GLF}\n"
"E2 6 4 5 0 10\n"
"E3 1 2 3 4 1\n"
"I1 0 7 10E-3\n"
"I2 0 8 10E-3\n"
"R1 3 0 1E9 \n"
"R2 3 0 1E9 \n"
"R3 3 6 1E9 \n"
"R4 5 0 {RNV} \n"
"R5 5 0 {RNV} \n"
"R6 3 4 1E9 \n"
"R7 4 0 1E9 \n"
".ENDS VNSE_0_TLV916x\n"
