    Component {
      Type          CScript
      Name          "ADC"
      Show          on
      Position      [2010, 300]
      Direction     up
      Flipped       off
      LabelPosition south
      CommentOut    DisabledOpenCircuit
      Parameter {
        Variable      "DialogGeometry"
        Value         "[687 256 834 560]"
        Show          off
      }
      Parameter {
        Variable      "NumInputs"
        Value         "3"
        Show          off
      }
      Parameter {
        Variable      "NumOutputs"
        Value         "5"
        Show          off
      }
      Parameter {
        Variable      "NumContStates"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "NumDiscStates"
        Value         "8"
        Show          off
      }
      Parameter {
        Variable      "NumZCSignals"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "DirectFeedthrough"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "Ts"
        Value         "62.5e-6"
        Show          off
      }
      Parameter {
        Variable      "TerminalBasedSampleTimes"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "Parameters"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "LangStandard"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "GnuExtensions"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "RuntimeCheck"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "HighlightLevel"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "Declarations"
        Value         "#include <math.h>\n"
"\n"
"#define v_in InputSignal(0,0)\n"
"#define i_in InputSignal(0,1)\n"
"#define t_in InputSignal(0,2)\n"
"\n"
"#define adc_state DiscState(0)\n"
"#define iso_state DiscState(1)\n"
"#define start_state DiscState(2)\n"
"\n"
"#define v_curr DiscState(3)\n"
"#define i_curr DiscState(4)\n"
"#define t_curr DiscState(5)\n"
"#define soc_curr DiscState(6)\n"
"\n"
"#define r_t DiscState(7)\n"
"\n"
"#define iso_out OutputSignal(0,0)\n"
"\n"
"#define v_out OutputSignal(0,1)\n"
"#define i_out OutputSignal(0,2)\n"
"#define t_out OutputSignal(0,3)\n"
"#define soc_out OutputSignal(0,4)"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         "// Variable to track which signal to sample next\n"
"adc_state = 0;\n"
"\n"
"// Variable to keep isolation switch OFF if \n"
"// unsafe operation is detected. Initially\n"
"// assume everything OK.\n"
"iso_state = 1;\n"
"\n"
"// Variable to prevent change of iso_state at t=0\n"
"start_state = 0;\n"
"\n"
"soc_curr = -1;"
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "iso_out = iso_state;\n"
"\n"
"v_out = v_curr;\n"
"i_out = i_curr;\n"
"t_out = t_curr;\n"
"soc_out = soc_curr;"
        Show          off
      }
      Parameter {
        Variable      "UpdateFcn"
        Value         "if (start_state == 0) {\n"
"\tstart_state++;\n"
"\treturn;\n"
"}\n"
"\n"
"if (adc_state == 0) { // sample voltage\n"
"\n"
"\tv_curr = v_in;\n"
"\n"
"\t// Turn isolation switch OFF if voltage out of range\n"
"\tif ((v_in < 2.515) || (v_in > 3.550)) {\n"
"\t\tiso_state = 0;\n"
"\t}\n"
"\t\n"
"\t// If SOC has not been initialised, or current is roughly zero\n"
"\tif ((soc_curr == -1) || ((i_curr > -0.002) && (i_curr < 0.002))) {\n"
"\t\t\n"
"\t\t// Use voltage to initialise SOC\n"
"\t\tsoc_curr = 100 * (v_in - 2.5);\n"
"\t\t\n"
"\t}\n"
"\t\n"
"} else if (adc_state == 1) { // sample current\n"
"\n"
"\t// Convert ADC input to SC current\n"
"\ti_curr = (i_in - 2.5) / (100 * 0.068);\n"
"\n"
"\t// Turn isolation switch OFF if current out of range\n"
"\tif ((i_in < 0.760) || (i_in > 4.240)) {\n"
"\t\tiso_state = 0;\n"
"\t}\n"
"\t\n"
"\t// If current is non-zero, calculate SOC via numerical integration\n"
"\tif ((i_curr > 0.002) || (i_curr < -0.002)) {\n"
"\n"
"\t\tsoc_curr = soc_curr + (i_curr * 0.0001875 / 64.8) * 100;\n"
"\t\n"
"\t}\n"
"\t\n"
"} else { // sample temperature\n"
"\t\n"
"\t// Convert ADC input to SC temperature\n"
"\tr_t = 10000 * (t_in) / (5 - t_in);\n"
"\tt_curr = 1 / (1/298.15 + log(r_t/10000)/4300) - 273.15;\n"
"\n"
"\t// Turn isolation switch OFF if current out of range\n"
"\tif ((t_in < 0.550) || (t_in > 4.450)) {\n"
"\t\tiso_state = 0;\n"
"\t}\n"
"\t\n"
"}\n"
"\n"
"// Sample different ADC channel next\n"
"adc_state++;\n"
"\n"
"if (adc_state >= 3) {\n"
"\tadc_state = 0;\n"
"}"
        Show          off
      }
      Parameter {
        Variable      "DerivativeFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "TerminateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "StoreCustomStateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "RestoreCustomStateFcn"
        Value         ""
        Show          off
      }
    }
