    Component {
      Type          CScript
      Name          "MCU with T/C"
      Show          on
      Position      [1080, 155]
      Direction     up
      Flipped       off
      LabelPosition south
      Parameter {
        Variable      "DialogGeometry"
        Value         "[592 247 717 516]"
        Show          off
      }
      Parameter {
        Variable      "NumInputs"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "NumOutputs"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "NumContStates"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "NumDiscStates"
        Value         "9"
        Show          off
      }
      Parameter {
        Variable      "NumZCSignals"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "DirectFeedthrough"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "Ts"
        Value         "0.5e-6"
        Show          off
      }
      Parameter {
        Variable      "TerminalBasedSampleTimes"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "Parameters"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "LangStandard"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "GnuExtensions"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "RuntimeCheck"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "HighlightLevel"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "Declarations"
        Value         "#define osc_in InputSignal(0,0)\n"
"\n"
"#define iso_state DiscState(0)\n"
"#define touch_curr DiscState(1)\n"
"#define touch_ready DiscState(2)\n"
"\n"
"#define count DiscState(3)\n"
"\n"
"#define osc_period DiscState(4)\n"
"#define osc_start DiscState(5)\n"
"#define osc_end DiscState(6)\n"
"#define osc_overflows DiscState(7)\n"
"\n"
"#define osc_in_prev DiscState(8)\n"
"\n"
"#define iso_out OutputSignal(0,0)"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         "// Assume output initially set to ON\n"
"iso_state = 1;\n"
"\n"
"// Assume touch sensor currently not detecting touch\n"
"touch_curr = 0;\n"
"\n"
"// Set output to toggle if a new touch is detected\n"
"touch_ready = 1; // equal 1 if electrode was not being touched before\n"
"\n"
"\n"
"// Set T/C to 0, initially\n"
"count = 0;\n"
"\n"
"\n"
"osc_period = 0;\n"
"osc_start = -1;\n"
"osc_end = 0;\n"
"osc_overflows = 0; // (except start, these shouldn't be used)\n"
"\n"
"osc_in_prev = 0;"
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "iso_out = iso_state; // debugging note: usually equals "
"iso_state."
        Show          off
      }
      Parameter {
        Variable      "UpdateFcn"
        Value         "// Simulate T/C0 or T/C2\n"
"count++;\n"
"\n"
"if (count >= 256) {\n"
"\tcount = 0;\n"
"\tosc_overflows++;\n"
"}\n"
"\n"
"if ((osc_in > 3) && (osc_in_prev < 2)) { // debug: detect rising edges\n"
"\t\n"
"\tif (osc_start == -1) { // first rising edge\n"
"\t\n"
"\t\t// Start stopwatch\n"
"\t\tosc_start = count;\n"
"\t\tosc_overflows = 0;\n"
"\t\t\n"
"\t} else {\n"
"\t\n"
"\t\t// Stop stopwatch, calculate oscillation period\n"
"\t\tosc_end = count;\n"
"\t\tosc_period = osc_end + 256 * osc_overflows - osc_start;\n"
"\t\t\n"
"\t\t// Electrode is being touched if period is large, and not being touched o"
"therwise.\n"
"\t\tif (osc_period > 212) { // currently being touched\n"
"\t\t\ttouch_curr = 1;\n"
"\t\t\t\n"
"\t\t\tif (touch_ready) { // if this is a new touch\n"
"\t\t\t\n"
"\t\t\t\ttouch_ready = 0;\n"
"\t\t\t\t\n"
"\t\t\t\t// Toggle output isolation switch\n"
"\t\t\t\tif (iso_state == 1) {\n"
"\t\t\t\t\tiso_state = 0;\n"
"\t\t\t\t} else {\n"
"\t\t\t\t\tiso_state = 1;\n"
"\t\t\t\t}\n"
"\t\t\t}\n"
"\t\t\t\n"
"\t\t} else { // not being touched\n"
"\t\t\ttouch_curr = 0;\n"
"\t\t\ttouch_ready = 1; // prepare to detect new touch\n"
"\t\t}\n"
"\t\t\n"
"\t\t// Restart stopwatch\n"
"\t\tosc_start = count;\n"
"\t\tosc_overflows = 0;\n"
"\t\t\n"
"\t}\n"
"}\n"
"\n"
"osc_in_prev = osc_in;"
        Show          off
      }
      Parameter {
        Variable      "DerivativeFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "TerminateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "StoreCustomStateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "RestoreCustomStateFcn"
        Value         ""
        Show          off
      }
    }
